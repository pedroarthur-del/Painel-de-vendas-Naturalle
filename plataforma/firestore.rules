rules_version = '2';
// =====================================================================
// REGRAS DE ACESSO · Plataforma Comercial Naturalle (Firestore)
// O login é um só: número do celular + senha no portal (Apps Script). Com a sessão válida,
// o portal emite um token do Firebase com papel, nome e abas da pessoa (claims) e um prazo
// ("ate", 3 h, renovado pela plataforma). Trocar a senha ou desativar o número no portal
// corta a renovação, e o acesso ao banco cai em até 3 h.
// Vendedor não recebe token: não lê nem grava nada aqui.
// Papéis: admin · gestor · membro · leitor   Abas: vendas · encaminhamentos · planejamento · remuneracao
// =====================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function tk() { return request.auth.token; }
    function ativo() {
      return request.auth != null
        && tk().get('papel', '') in ['admin', 'gestor', 'membro', 'leitor']
        && request.time.toMillis() < tk().get('ate', 0);
    }
    function papel() { return tk().papel; }
    function nome() { return tk().get('nome', ''); }
    function admin() { return ativo() && papel() == 'admin'; }
    function aba(a) { return admin() || (ativo() && tk().get('abas', {}).get(a, false) == true); }
    function gestor(a) { return admin() || (aba(a) && papel() == 'gestor'); }
    function escreve(a) { return gestor(a) || (aba(a) && papel() == 'membro'); }
    function soMuda(campos) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(campos); }

    // Responsáveis dos encaminhamentos (nomes, cargos)
    match /pessoas/{id} {
      allow read: if ativo();
      allow write: if admin() || gestor('encaminhamentos');
    }

    // Configurações gerais (segurança, automações, remuneração da plataforma)
    match /config/{id} {
      allow read: if ativo();
      allow write: if admin()
        || (id == 'automacoes' && gestor('encaminhamentos'))
        || (id == 'remuneracao' && gestor('remuneracao'));
    }

    // Encaminhamentos (quadro)
    match /tarefas/{id} {
      allow read: if aba('encaminhamentos');
      allow create: if escreve('encaminhamentos');
      allow update: if gestor('encaminhamentos')
        || (escreve('encaminhamentos') && (resource.data.get('resp', '') == nome() || resource.data.get('criadoPor', '') == nome()))
        || (escreve('encaminhamentos') && soMuda(['comentarios']));
      allow delete: if gestor('encaminhamentos');
    }

    // Reuniões e atas
    match /reunioes/{id} {
      allow read: if aba('encaminhamentos');
      allow write: if gestor('encaminhamentos');
    }

    // Planejamento comercial
    match /frentes/{id} {
      allow read: if aba('planejamento');
      allow write: if gestor('planejamento');
    }
    match /iniciativas/{id} {
      allow read: if aba('planejamento');
      allow write: if gestor('planejamento');
    }
    match /metas/{ano} {
      allow read: if ativo();
      allow write: if gestor('planejamento');
    }

    // Qualquer outra coleção fica fechada
    match /{doc=**} { allow read, write: if false; }
  }
}
